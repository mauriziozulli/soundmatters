---
/**
 * Ein Abschnitt: eine Bildschirmhöhe, oben die Einordnung, in der Mitte
 * der Balken mit dem ausgestanzten Wort, unten Fussnote und höchstens eine
 * Weiterführung.
 *
 * Der hervorgehobene Teil des Satzes wird als Textstelle gesucht, nicht
 * als eigenes Feld gepflegt. **`betont` muss darum wörtlich in `satz`
 * vorkommen** — sonst verschwindet die Hervorhebung stillschweigend.
 */
import Balken from './Balken.astro';
import type { Abschnitt } from '../data/inhalt';

interface Props { a: Abschnitt }
const { a } = Astro.props;

const stelle = a.betont ? a.satz.indexOf(a.betont) : -1;
const davor = stelle >= 0 ? a.satz.slice(0, stelle) : a.satz;
const betont = stelle >= 0 ? a.betont! : '';
const danach = stelle >= 0 ? a.satz.slice(stelle + a.betont!.length) : '';

const pfeil = a.link?.art === 'extern' ? '↗' : '→';
/* Name für die Spur unten: was oben im Balken steht, plus die Zeile
   darunter. Steht das Wort allein, genügt das Wort. */
const name = [a.wort, a.zweite].filter(Boolean).join(' ');
---

<section
  class="abschnitt"
  data-abschnitt
  data-name={name}
  style={`--boden: ${a.farben.boden}; --bar: ${a.farben.bar}; --zweit: ${a.farben.zweit}`}
>
  {/* Nur wo eine Spur nach aussen wirkt (03 pumpt auf dem Schlag). Die
      Fläche liegt hinter allem und wird vom Skript gesteuert. */}
  {a.spur === 'spektrum' && <span class="puls" data-puls aria-hidden="true"></span>}

  <div class="kopf">
    <span>{a.nummer}</span>
    <span>{a.einordnung}</span>
  </div>

  <div class="mitte">
    <h1 class="wortmarke">
      <Balken wort={a.wort} spur={a.spur} saat={a.saat} farben={a.farben} />
      {a.zweite && <span class="zweite">{a.zweite}</span>}
    </h1>

    <p class="satz">{davor}{betont && <b>{betont}</b>}{danach}</p>

    {/* Fussnote und Weiterführung stehen MITTIG, nicht am unteren Rand.
        Dort lagen sie einmal — und wurden auf dem iPhone von Safaris
        schwebender Adressleiste und der Spur überdeckt. Unten steht jetzt
        nichts mehr, was abgeschnitten werden kann. */}
    <p class="fussnote">{a.fussnote}</p>
    {a.link && <a class="weiter" href={a.link.ziel}>{a.link.text} {pfeil}</a>}
  </div>
</section>
