---
import Balken from './Balken.astro';
import type { Ebene, Fassung } from '../data/inhalt';

interface Props { e: Ebene; offen?: boolean; beschriftung: Fassung['beschriftung'] }
const { e, offen = false, beschriftung } = Astro.props;
---

<div
  class="ebene"
  data-ebene={e.schluessel}
  data-offen={offen ? 'true' : 'false'}
  role="dialog"
  aria-modal="true"
  aria-label={e.titel}
  style={`--ef: ${e.farbe}`}
>
  <button class="ebene__zu" type="button">{beschriftung.schliessen}</button>

  <div class="ebene__in">
    <div class="ebene__kicker">{e.kicker}</div>

    {/* Dieselbe Balkensprache wie auf dem Plakat, nur still: eine Ebene
        ist ein Detailblatt und soll nicht mit sich selber konkurrieren. */}
    <h1 class="ebene__titel">
      <Balken wort={e.titel} spur={e.spur} saat={e.saat} farben={e.farben} statisch />
    </h1>
    <p class="ebene__vorspann">{e.vorspann}</p>

    {e.bildgruppen && e.bildgruppen.length > 0 && (
      <div class="bildgruppen">
        {e.bildgruppen.map((g) => (
          <figure class="bildgruppe">
            <div class="bildgruppe__bilder">
              {g.dateien.map((d) => <img src={d} alt="" loading="lazy" decoding="async" />)}
            </div>
            <figcaption>{g.text}</figcaption>
          </figure>
        ))}
      </div>
    )}

    {/* Kein Bild, keine Lücke: ein sichtbarer Platzhalter auf einer
        veröffentlichten Seite liest sich als Baustelle. Was fehlt, steht
        in der Übergabe, nicht auf der Seite. */}
    {e.bild && <img class="ebene__bild" src={e.bild} alt="" loading="lazy" decoding="async" />}

    {e.bloecke?.map((b) => (
      <div class="ebene__block">
        <h3>{b.titel}</h3>
        <p>{b.text}</p>
      </div>
    ))}

    {e.daten && e.daten.length > 0 && (
      <dl class="ebene__daten">
        {e.daten.map((d) => (
          <div class="ebene__zeile">
            <dt>{d.was}</dt>
            <dd>{d.wert}</dd>
          </div>
        ))}
      </dl>
    )}

    {/* Einzelne Geräte. Bewusst ohne Links — eine dritte Ebene gibt es nicht. */}
    {e.stuecke && e.stuecke.length > 0 && (
      <section class="stuecke">
        <h2 class="stuecke__marke">{beschriftung.stuecke}</h2>

        {e.stuecke.map((st) => (
          <article class="stueck">
            <div class="stueck__einordnung">{st.einordnung}</div>
            <h3 class="stueck__titel">{st.titel}</h3>
            <p class="stueck__text">{st.text}</p>
            {st.bilder && st.bilder.length > 0 && (
              <div class="bildreihe" data-anzahl={st.bilder.length}>
                {st.bilder.map((f) => (
                  <figure class="bildreihe__bild">
                    <img src={f.datei} alt="" loading="lazy" decoding="async" />
                    <figcaption>{f.text}</figcaption>
                  </figure>
                ))}
              </div>
            )}
            <dl class="stueck__daten">
              {st.daten.map((d) => (
                <div class="stueck__zeile">
                  <dt>{d.was}</dt>
                  <dd>{d.wert}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))}
      </section>
    )}

    {e.handlung && (
      <a class="ebene__handlung" href={e.handlung.ziel}>{e.handlung.text} →</a>
    )}
  </div>
</div>
