---
import '../styles/global.css';
import { BASIS, gegenstueck, mitStrich, type Sprache } from '../data/inhalt';
import { personLd, seiteLd } from '../data/person';

interface Props { sprache?: Sprache; titel?: string; beschreibung?: string }
const {
  sprache = 'de',
  titel = 'Sound Matters',
  beschreibung = 'Maurizio Zulli aus Luzern: Ton für Film und Video, selbst gebaute Recording-Rigs, Musik und Feldaufnahmen.'
} = Astro.props;

const pfad = mitStrich(Astro.url.pathname);
const andereSprache: Sprache = sprache === 'de' ? 'en' : 'de';
const andererPfad = gegenstueck(sprache, pfad);

/* Strukturierte Daten: sagen der Suchmaschine, dass hinter dieser Adresse
   ein Mensch steht — derselbe wie hinter mauriziozulli.com. Ohne das ist
   «Sound Matters» eine namenlose Seite. Warum das so gebaut ist und was
   beim Ändern zu beachten wäre, steht in data/person.ts. */
const person = personLd(sprache);
const seite = seiteLd(sprache, new URL(pfad, Astro.site).toString());
---

<!doctype html>
<html lang={sprache} data-basis={BASIS[sprache]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={new URL(pfad, Astro.site)} />

    <!-- Beide Fassungen kennen einander, damit Suchmaschinen die richtige
         ausliefern und keine als Kopie der anderen gilt. -->
    <link rel="alternate" hreflang={sprache} href={new URL(pfad, Astro.site)} />
    <link rel="alternate" hreflang={andereSprache} href={new URL(andererPfad, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(sprache === 'de' ? pfad : andererPfad, Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={sprache === 'de' ? 'de_CH' : 'en_GB'} />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Leitschrift und Gegenstimme tragen die Überschriften — vor allem
         anderen holen. Die Mono kommt erst in der Fusszeile zum Zug. -->
    <link rel="preload" as="font" type="font/woff2" href="/schriften/heavy.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/schriften/mono.woff2" crossorigin />

    <meta name="theme-color" content="#101014" />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script type="application/ld+json" set:html={JSON.stringify(seite)} />
  </head>

  <body>
    <div class="zeiger zeiger--ring" aria-hidden="true"></div>
    <div class="zeiger zeiger--punkt" aria-hidden="true"></div>

    <slot />

    <script>
      import { spurenAufbauen } from '../scripts/spuren';
      import { ebenenAufbauen } from '../scripts/ebene';
      import { zeigerAufbauen } from '../scripts/zeiger';

      ebenenAufbauen();
      zeigerAufbauen();

      /* Die Spuren warten intern auf die Leitschrift: mit der Ersatzschrift
         ausgestanzt sässe das Wort sichtbar daneben. */
      spurenAufbauen();
    </script>
  </body>
</html>
